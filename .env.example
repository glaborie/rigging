# Copy to .env. Secrets live here and only here (never in a manifest).

# --- default gateway -------------------------------------------------------
# OmniRoute (OpenAI-compatible): http://localhost:20128/v1
# Ollama's own OpenAI-compatible surface: http://localhost:11434/v1
RIGGING_BASE_URL=http://localhost:20128/v1
RIGGING_API_KEY=not-needed
RIGGING_MODEL=beam:cloud

# --- named credential profiles (a manifest names one of these) ------------
# Ollama cloud models: run `ollama signin` first, no API key needed.
RIGGING_PROFILE_OLLAMA_BASE_URL=http://localhost:11434/v1
RIGGING_PROFILE_OLLAMA_API_KEY=ollama

RIGGING_PROFILE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RIGGING_PROFILE_OPENROUTER_API_KEY=

# --- gateway dashboard (OmniRoute) ------------------------------------------
# Bootstrap password for the OmniRoute dashboard, used on FIRST boot of the
# omniroute-data volume only — later restarts ignore it. If login is refused, the
# volume was seeded by the packaged npm .env instead: run
#   make gateway-password PW=<new-password>
# (or scripts/omniroute-reset-password.sh), then change it in Settings -> Security.
OMNIROUTE_INITIAL_PASSWORD=CHANGEME

# --- storage ---------------------------------------------------------------
RIGGING_DB_PATH=rigging.db
RIGGING_PRICES_FILE=prices.yaml

# --- retrieval (v0.3) ------------------------------------------------------
QDRANT_URL=http://localhost:6345
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- observability (v0.4) --------------------------------------------------
RIGGING_OTLP_ENDPOINT=
RIGGING_OTLP_HEADERS=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
