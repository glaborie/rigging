# Copy to .env. Secrets live here and only here (never in a manifest).

# --- default gateway -------------------------------------------------------
# OmniRoute (OpenAI-compatible): http://localhost:20128/v1
# Ollama's own OpenAI-compatible surface: http://localhost:11434/v1
RIGGING_BASE_URL=http://localhost:20128/v1
RIGGING_API_KEY=not-needed
RIGGING_MODEL=beam:cloud

# --- named credential profiles (a manifest names one of these) ------------
# Ollama cloud models: run `ollama signin` first, no API key needed.
RIGGING_PROFILE_OLLAMA_BASE_URL=http://localhost:11434/v1
RIGGING_PROFILE_OLLAMA_API_KEY=ollama

RIGGING_PROFILE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The canonical demo (`examples/b2b-support/agent.yaml`) uses this profile.
RIGGING_PROFILE_OPENROUTER_API_KEY=

# --- gateway dashboard (OmniRoute) ------------------------------------------
# Bootstrap password for the OmniRoute dashboard, used on FIRST boot of the
# omniroute-data volume only — later restarts ignore it. If login is refused, the
# volume was seeded by the packaged npm .env instead: run
#   make gateway-password PW=<new-password>
# (or scripts/omniroute-reset-password.sh), then change it in Settings -> Security.
OMNIROUTE_INITIAL_PASSWORD=CHANGEME

# --- storage ---------------------------------------------------------------
RIGGING_DB_PATH=rigging.db
RIGGING_PRICES_FILE=prices.yaml

# --- retrieval (v0.3) ------------------------------------------------------
QDRANT_URL=http://localhost:6345
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- observability (v0.4) --------------------------------------------------
# Traces go to Langfuse Cloud — there is no local Langfuse stack in compose.
# LANGFUSE_HOST defaults to https://cloud.langfuse.com when empty.
RIGGING_OTLP_ENDPOINT=
RIGGING_OTLP_HEADERS=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# MLflow (optional second backend, ADR-0020). No SDK needed: the exporter speaks
# the tracking REST API. `exporters: [mlflow]` in a manifest.
# --- web view auth (ADR-0021) ----------------------------------------------
# Comma-separated to allow rotation. Empty = no auth, which `harness serve`
# only allows on a loopback bind.
RIGGING_SERVICE_TOKEN=

# --- chat UI (ADR-0028) -----------------------------------------------------
# `make openai` serves /v1 for LibreChat; `make librechat` runs the UI in Docker.
# The same RIGGING_SERVICE_TOKEN above is the endpoint's API key.
# Base URL as seen from the LibreChat container (host.docker.internal is the host).
RIGGING_LIBRECHAT_BASE_URL=http://host.docker.internal:8000/v1
LIBRECHAT_PORT=3080

MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_ID=0
MLFLOW_TRACKING_TOKEN=

# --- PII at rest (ADR-0027) --------------------------------------------------
# 32 bytes, base64 or 64 hex chars. Generate one:
#   python -c "from rigging.crypto import new_key; print(new_key())"
# With a key: contacts a tool stores are AEAD-sealed, and the per-session sentinel
# map is sealed into RIGGING_PII_VAULT_DIR so a restart does not lose it. Needs the
# [vault] extra (make install). Without a key: maps are memory-only, tool rows are
# plaintext. Changing the key makes values sealed with the old one unreadable.
RIGGING_PII_KEY=
RIGGING_PII_VAULT_DIR=runs/pii-vault
RIGGING_PII_VAULT_TTL_S=3600
