FROM node:22-alpine AS install
RUN npm install --global omniroute

FROM node:22-alpine
COPY --from=install /usr/local/lib/node_modules /usr/local/lib/node_modules
ENV PATH="/usr/local/lib/node_modules/omniroute/node_modules/.bin:/usr/local/bin:$PATH"
EXPOSE 20128
CMD ["node", "/usr/local/lib/node_modules/omniroute/bin/omniroute.mjs", "serve", "--port", "20128"]
